{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://www.kultursanatis.com.tr",
    "NEXT_PUBLIC_API_URL": "https://www.kultursanatis.com.tr"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
