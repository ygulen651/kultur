{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/cloudinary/upload/route.ts": {
      "maxDuration": 300
    }
  },
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://www.kultursanatis.com.tr",
    "NEXT_PUBLIC_API_URL": "https://www.kultursanatis.com.tr"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    {
      "source": "/api/cloudinary/upload",
      "destination": "/api/cloudinary/upload"
    }
  ]
}
